{
  "name": "playflix",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "dev:all": "concurrently -k -n web,api -c magenta,cyan \"npm:dev\" \"npm:server\"",
    "db:migrate": "tsx server/migrate.ts",
    "build": "tsc -b && vite build",
    "build:vercel": "esbuild server/vercel-entry.ts --bundle --platform=node --target=node20 --format=esm --packages=external --banner:js=\"// Generated by npm run build:vercel. Do not edit.\" --outfile=\"api/index.js\"",
    "preview": "vite preview",
    "test:e2e": "node scripts/e2e-reset.mjs && playwright test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^0.545.0",
    "pg": "^8.23.1",
    "posthog-js": "1.444.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.12",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vite": "^7.1.3"
  }
}
