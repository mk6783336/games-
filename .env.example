# Managed PostgreSQL (Neon, etc.). Leave empty to use the local PGlite
# Postgres-compatible development database at .data/pglite.
# Pooled connection — application traffic (see neon-postgres skill).
DATABASE_URL=
# Direct connection — schema migrations only (npm run db:migrate).
DATABASE_URL_UNPOOLED=
PGLITE_DIR=.data/pglite

# API server
PORT=8787
APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development

# Web client. Defaults to http://<current-host>:8787 when omitted.
VITE_API_URL=
